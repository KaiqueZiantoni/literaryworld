# Copie para .env e preencha. O .env fica fora do versionamento.
# Para produção, os mesmos nomes viram variáveis de ambiente no Render —
# o passo a passo está em DEPLOY.md.

# ── Banco ────────────────────────────────────────────────────────────────
DB_USER=literary_app
DB_PASSWORD=gere-uma-senha-forte
# Só em produção; local cai para o Postgres do docker-compose na porta 5433
# DATABASE_URL=jdbc:postgresql://SEU-HOST.neon.tech/literaryworld?sslmode=require

# ── Segredos ─────────────────────────────────────────────────────────────
# openssl rand -hex 44
JWT_SECRET=
GOOGLE_BOOKS_API_KEY=

# ── Rede e sessão (só precisam de valor em produção) ─────────────────────
# CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None

# ── Política de e-mail ───────────────────────────────────────────────────
# Porta de serviço de desenvolvimento. VAZIO em produção.
EMAIL_TRUSTED_DOMAINS=teste.com
